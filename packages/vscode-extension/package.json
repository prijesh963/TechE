{
  "name": "@copilot-architect/vscode-extension",
  "displayName": "Copilot Architect",
  "description": "Thin VS Code shell for Copilot Architect CLI and MCP workflows.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publisher": "internal",
  "repository": {
    "type": "git",
    "url": "https://github.com/prijesh963/TechE.git"
  },
  "categories": [
    "Other"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "activationEvents": [
    "onStartupFinished",
    "onChatParticipant:copilot-architect.architect",
    "onView:copilotArchitect.dashboard",
    "onCommand:copilotArchitect.openDashboard",
    "onCommand:copilotArchitect.refreshDashboard",
    "onCommand:copilotArchitect.analyzeRepo",
    "onCommand:copilotArchitect.buildIndex",
    "onCommand:copilotArchitect.buildGraph",
    "onCommand:copilotArchitect.startMcp",
    "onCommand:copilotArchitect.generateInstructions",
    "onCommand:copilotArchitect.openRepoInNewWindow",
    "onCommand:copilotArchitect.workspaceScan",
    "onCommand:copilotArchitect.setupMcp",
    "onCommand:copilotArchitect.setupRepo",
    "onCommand:copilotArchitect.startAndSetupMcp",
    "onCommand:copilotArchitect.stopMcp",
    "onCommand:copilotArchitect.moreActions",
    "onCommand:copilotArchitect.approvePlan",
    "onCommand:copilotArchitect.confirmDecision",
    "onCommand:copilotArchitect.openPlannedFile",
    "onCommand:copilotArchitect.runValidation",
    "onCommand:copilotArchitect.showStagedDiff",
    "onCommand:copilotArchitect.applyChanges",
    "onCommand:copilotArchitect.endSession"
  ],
  "contributes": {
    "commands": [
      {
        "command": "copilotArchitect.openDashboard",
        "title": "Copilot Architect: Open Dashboard"
      },
      {
        "command": "copilotArchitect.refreshDashboard",
        "title": "Copilot Architect: Refresh Dashboard",
        "icon": "$(refresh)"
      },
      {
        "command": "copilotArchitect.analyzeRepo",
        "title": "Copilot Architect: Analyze Repo",
        "icon": "$(repo)"
      },
      {
        "command": "copilotArchitect.buildIndex",
        "title": "Copilot Architect: Build Index",
        "icon": "$(database)"
      },
      {
        "command": "copilotArchitect.buildGraph",
        "title": "Copilot Architect: Build Symbol Graph"
      },
      {
        "command": "copilotArchitect.startMcp",
        "title": "Copilot Architect: Start MCP",
        "icon": "$(server-process)"
      },
      {
        "command": "copilotArchitect.generateInstructions",
        "title": "Copilot Architect: Generate Instructions",
        "icon": "$(book)"
      },
      {
        "command": "copilotArchitect.openRepoInNewWindow",
        "title": "Copilot Architect: Open Repo",
        "icon": "$(folder-opened)"
      },
      {
        "command": "copilotArchitect.workspaceScan",
        "title": "Copilot Architect: Scan and Register Sub-repos",
        "icon": "$(source-control)"
      },
      {
        "command": "copilotArchitect.setupMcp",
        "title": "Copilot Architect: Setup MCP Server",
        "icon": "$(plug)"
      },
      {
        "command": "copilotArchitect.setupRepo",
        "title": "Copilot Architect: Setup Repo",
        "icon": "$(rocket)"
      },
      {
        "command": "copilotArchitect.startAndSetupMcp",
        "title": "Copilot Architect: Start & Setup MCP",
        "icon": "$(plug)"
      },
      {
        "command": "copilotArchitect.stopMcp",
        "title": "Copilot Architect: Stop MCP",
        "icon": "$(debug-stop)"
      },
      {
        "command": "copilotArchitect.moreActions",
        "title": "Copilot Architect: More Actions",
        "icon": "$(ellipsis)"
      },
      {
        "command": "copilotArchitect.approvePlan",
        "title": "Copilot Architect: Approve Plan"
      },
      {
        "command": "copilotArchitect.confirmDecision",
        "title": "Copilot Architect: Confirm Decision"
      },
      {
        "command": "copilotArchitect.openPlannedFile",
        "title": "Copilot Architect: Open Planned File"
      },
      {
        "command": "copilotArchitect.runValidation",
        "title": "Copilot Architect: Run Plan Validation"
      },
      {
        "command": "copilotArchitect.showStagedDiff",
        "title": "Copilot Architect: Show Staged Diff"
      },
      {
        "command": "copilotArchitect.applyChanges",
        "title": "Copilot Architect: Apply Staged Changes"
      },
      {
        "command": "copilotArchitect.endSession",
        "title": "Copilot Architect: End Session"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "copilotArchitect",
          "title": "Copilot Architect",
          "icon": "resources/copilot-architect.svg"
        }
      ]
    },
    "views": {
      "copilotArchitect": [
        {
          "id": "copilotArchitect.dashboard",
          "name": "Copilot Architect",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "copilotArchitect.refreshDashboard",
          "when": "view == copilotArchitect.dashboard",
          "group": "navigation"
        }
      ]
    },
    "chatParticipants": [
      {
        "id": "copilot-architect.architect",
        "fullName": "Copilot Architect",
        "name": "architect",
        "description": "Analyze repos, generate plans, validate, and review with Copilot Architect",
        "isSticky": true,
        "commands": [
          {
            "name": "analyze",
            "description": "Explore the repo \u2014 use before planning a change"
          },
          {
            "name": "create-plan",
            "description": "Draft an implementation plan you approve before any code is written"
          },
          {
            "name": "implement",
            "description": "Apply the approved plan"
          },
          {
            "name": "review",
            "description": "Compare what was built against what was approved"
          },
          {
            "name": "help",
            "description": "Show what Copilot Architect can do"
          }
        ]
      }
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@copilot-architect/agents": "0.1.0",
    "@copilot-architect/core": "0.1.0",
    "@copilot-architect/grounding": "0.1.0",
    "@copilot-architect/indexer": "0.1.0",
    "@copilot-architect/planner": "0.1.0",
    "@copilot-architect/reviewer": "0.1.0",
    "@copilot-architect/session": "0.1.0",
    "@copilot-architect/shared": "0.1.0",
    "@copilot-architect/validator": "0.1.0"
  }
}
